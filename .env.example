# ===== FIREBASE CONFIGURATION =====
# Get these from Firebase Console > Project Settings
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID
FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# ===== GEMINI AI API (Server-side only) =====
# Get from Google Cloud Console > APIs & Services > Credentials
# NEVER expose this in mobile app - use only in Cloud Functions
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ===== GOOGLE ADMOB =====
# Get from AdMob Console
ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
# Test Ad Unit IDs (use during development, never use in production without testing)
ADMOB_BANNER_AD_UNIT_ID=ca-app-pub-3940256099942544/6300978111
ADMOB_INTERSTITIAL_AD_UNIT_ID=ca-app-pub-3940256099942544/1033173712
ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-3940256099942544/5224354917
ADMOB_NATIVE_AD_UNIT_ID=ca-app-pub-3940256099942544/2247696110

# ===== GOOGLE PLAY BILLING SUBSCRIPTION PRODUCT IDs =====
# Create these in Google Play Console > Monetize > Subscriptions
# Must match exactly the product IDs in Play Console
SUBSCRIPTION_WEEKLY_ID=mobibiz.weekly
SUBSCRIPTION_MONTHLY_ID=mobibiz.monthly
SUBSCRIPTION_PREMIUM_MONTHLY_ID=mobibiz.premium.monthly
SUBSCRIPTION_YEARLY_ID=mobibiz.yearly

# Subscription prices (informational - prices set in Play Console)
SUBSCRIPTION_WEEKLY_PRICE=35000
SUBSCRIPTION_MONTHLY_PRICE=60000
SUBSCRIPTION_PREMIUM_MONTHLY_PRICE=100000
SUBSCRIPTION_YEARLY_PRICE=400000
SUBSCRIPTION_CURRENCY=UGX

# ===== APPLICATION CONFIGURATION =====
APP_ENV=development
APP_VERSION=1.0.0

# Support and legal pages
SUPPORT_EMAIL=YOUR_SUPPORT_EMAIL
PRIVACY_POLICY_URL=https://YOUR_DOMAIN/privacy
TERMS_OF_SERVICE_URL=https://YOUR_DOMAIN/terms
SUBSCRIPTION_TERMS_URL=https://YOUR_DOMAIN/subscription-terms

# Owner account (set after deployment)
OWNER_EMAIL=your-admin-email@gmail.com
