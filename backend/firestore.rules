rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function ownerDoc() {
      return get(/databases/$(database)/documents/admins/owner);
    }

    function isOwner(uid) {
      // Only true if the owner document exists and matches the uid
      return ownerDoc().exists && ownerDoc().data.uid == uid;
    }

    function hasValidSubscription(uid) {
      let subscription = get(/databases/$(database)/documents/subscriptions/$(uid));
      return subscription.exists && subscription.data.status == 'active' && subscription.data.expiryDate > now;
    }

    // Admins/owner document - client-side creation is disallowed. Owner must be provisioned server-side via Admin SDK or a secure callable function.
    match /admins/owner {
      allow read: if isAuthenticated() && isOwner(request.auth.uid);
      allow create: if false; // creation must be done server-side with admin privileges
      allow update, delete: if isAuthenticated() && isOwner(request.auth.uid);
    }

    // Admin settings - only owner may write/read sensitive settings
    match /adminSettings/{document=**} {
      allow read: if isAuthenticated() && isOwner(request.auth.uid);
      allow write: if isAuthenticated() && isOwner(request.auth.uid);
    }

    // Users collection
    match /users/{uid} {
      allow read: if isOwnUser(uid) || (isAuthenticated() && isOwner(request.auth.uid));
      // Allow authenticated user to create their own profile document. Do not require inverted email_verified.
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if isOwnUser(uid);
      allow delete: if isOwnUser(uid) || (isAuthenticated() && isOwner(request.auth.uid));

      // User's business data - users can only access their own
      match /businesses/{document=**} {
        allow read, write: if isOwnUser(uid);
      }

      match /sales/{document=**} {
        allow read, write: if isOwnUser(uid);
      }

      match /expenses/{document=**} {
        allow read, write: if isOwnUser(uid);
      }

      match /products/{document=**} {
        allow read, write: if isOwnUser(uid);
      }

      match /customers/{document=**} {
        allow read, write: if isOwnUser(uid);
      }

      match /invoices/{document=**} {
        allow read, write: if isOwnUser(uid);
      }

      match /receipts/{document=**} {
        allow read, write: if isOwnUser(uid);
      }
    }

    // Subscriptions - only owner (via admin) or server-side admin SDK should create/update subscriptions.
    match /subscriptions/{uid} {
      allow read: if isOwnUser(uid) || (isAuthenticated() && isOwner(request.auth.uid));
      allow write: if false; // writes must be performed server-side with admin privileges
    }

    // Public content - Help Center, FAQ
    match /helpCenter/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isOwner(request.auth.uid);
    }

    match /faq/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isOwner(request.auth.uid);
    }

    match /announcements/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isOwner(request.auth.uid);
    }

    // Analytics - owner and self can read
    match /analytics/{uid} {
      allow read: if isOwnUser(uid) || (isAuthenticated() && isOwner(request.auth.uid));
      allow write: if isAuthenticated() && isOwner(request.auth.uid);
    }
  }
}
